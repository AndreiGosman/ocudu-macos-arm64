From 94912976fb7876013d170f6d66770e52ff5312bd Mon Sep 17 00:00:00 2001
From: Andrei Gosman <andrei.gosman@gmail.com>
Date: Thu, 1 Oct 2026 12:27:51 +0300
Subject: [PATCH] gateways: give the Darwin sendmmsg emulation exact sockaddr
 lengths

udp_network_gateway_impl fills msg_namelen with sizeof(sockaddr_storage)
for every destination. Linux accepts any length that covers the address.
The Darwin IPv6 output path requires msg_namelen to be exactly
sizeof(sockaddr_in6) with a matching sin6_len and fails with EINVAL
otherwise, which is why the IPv6 UDP gateway test could not send while
the IPv4 cases passed.

Let the sendmmsg emulation hand the kernel a copy of each destination
with the length of its address family and ss_len set. The caller's
structures are not touched and the gateway source is unchanged.
---
 include/ocudu/support/os/mmsg_compat.h | 24 +++++++++++++++++++++++-
 1 file changed, 23 insertions(+), 1 deletion(-)

diff --git a/include/ocudu/support/os/mmsg_compat.h b/include/ocudu/support/os/mmsg_compat.h
index 4c8e56a..8d9187d 100644
--- a/include/ocudu/support/os/mmsg_compat.h
+++ b/include/ocudu/support/os/mmsg_compat.h
@@ -16,7 +16,9 @@
 #ifdef __APPLE__
 
 #include <cerrno>
+#include <cstring>
 #include <ctime>
+#include <netinet/in.h>
 
 /// Linux: "wait for one message, then return whatever else is already queued". The Linux value (0x10000) is Darwin's
 /// MSG_NEEDSA, so a free bit is used here; recvmmsg() strips it before calling recvmsg().
@@ -33,7 +35,27 @@ inline int sendmmsg(int sockfd, struct mmsghdr* msgvec, unsigned vlen, int flags
 {
   unsigned sent = 0;
   for (; sent < vlen; ++sent) {
-    ssize_t ret = ::sendmsg(sockfd, &msgvec[sent].msg_hdr, flags);
+    struct msghdr hdr = msgvec[sent].msg_hdr;
+    // Linux takes any msg_namelen that covers the address; callers pass sizeof(sockaddr_storage). The Darwin IPv6
+    // output path requires the exact sockaddr_in6 length and a matching sin6_len, otherwise sendmsg fails with
+    // EINVAL. Hand the kernel a copy with the length of the address family.
+    struct sockaddr_storage name;
+    if (hdr.msg_name != nullptr and hdr.msg_namelen >= sizeof(sa_family_t)) {
+      const auto* sa  = static_cast<const struct sockaddr*>(hdr.msg_name);
+      socklen_t   len = hdr.msg_namelen;
+      if (sa->sa_family == AF_INET) {
+        len = sizeof(struct sockaddr_in);
+      } else if (sa->sa_family == AF_INET6) {
+        len = sizeof(struct sockaddr_in6);
+      }
+      if (len <= hdr.msg_namelen and len <= sizeof(name)) {
+        ::memcpy(&name, hdr.msg_name, len);
+        name.ss_len     = static_cast<uint8_t>(len);
+        hdr.msg_name    = &name;
+        hdr.msg_namelen = len;
+      }
+    }
+    ssize_t ret = ::sendmsg(sockfd, &hdr, flags);
     if (ret < 0) {
       // Linux reports the error only when nothing was sent; otherwise it returns the count and the error waits for
       // the next call.
-- 
