index f3d26b2..f5715d3 100644
--- a/include/ocudu/support/io/io_broker_factory.h
+++ b/include/ocudu/support/io/io_broker_factory.h
@@ -8,7 +8,11 @@
 
 namespace ocudu {
 
-enum class io_broker_type { epoll, io_uring };
+/// \brief Available IO broker backends.
+///
+/// epoll is the Linux backend. kqueue is the Darwin/BSD backend; on those systems a request for epoll is served by
+/// kqueue, so callers keep one spelling.
+enum class io_broker_type { epoll, io_uring, kqueue };
 
 /// Creates an instance of an IO broker
 std::unique_ptr<io_broker> create_io_broker(io_broker_type type, const io_broker_config& config = io_broker_config());
