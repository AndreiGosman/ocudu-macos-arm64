From d9c3bbb0a09696c9a2d7f56a1a7965969c4f8930 Mon Sep 17 00:00:00 2001
From: Andrei Gosman <andrei.gosman@gmail.com>
Date: Thu, 1 Oct 2026 16:16:00 +0300
Subject: [PATCH] gateways: bind the BSD socket calls to the SCTP shim on macOS

On macOS the SCTP library is libsctp-compat, which implements socket(),
bind(), connect(), setsockopt(), sendmsg(), recvmsg() and the rest of the
BSD socket calls over usrsctp, next to the sctp_*() helpers. With the
two-level namespace the linker binds each undefined symbol to the first
library on the command line that exports it. CMake lists libraries after
the object files, so the gNB bound sctp_connectx() to the shim but
socket() and setsockopt() to libSystem: the socket() call reached the
kernel, which has no SCTP, and the CU-CP logged "Failed to create SCTP
socket" with no association ever attempted.

Pass the SCTP library through the gateway target's interface link
options as well. Link options precede the object files, so the shim comes
ahead of libSystem for every executable that links ocudu_gateway, and nm
shows socket and setsockopt bound to libsctp. Linux is unchanged.
---
 lib/gateways/CMakeLists.txt | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/lib/gateways/CMakeLists.txt b/lib/gateways/CMakeLists.txt
index 98ec6f3..0504b88 100644
--- a/lib/gateways/CMakeLists.txt
+++ b/lib/gateways/CMakeLists.txt
@@ -32,6 +32,16 @@ add_library(ocudu_gateway
 # libsctp installed under another prefix, as on macOS, this is what makes the header reachable.
 target_include_directories(ocudu_gateway SYSTEM PUBLIC ${SCTP_INCLUDE_DIRS})
 
+if (APPLE)
+    # The SCTP library on macOS is a shim that implements socket(), bind(), connect(), setsockopt(), sendmsg() and the
+    # other BSD calls over usrsctp, next to the sctp_*() helpers. With the two-level namespace the linker binds each
+    # undefined symbol to the first library on the command line that exports it, and libSystem exports all of them.
+    # Listing the library among the link options puts it in front of the object files, ahead of libSystem, so the BSD
+    # calls of every executable that uses the gateways bind to the shim. Without this the gNB reaches the kernel, which
+    # has no SCTP, and "Failed to create SCTP socket".
+    target_link_options(ocudu_gateway INTERFACE ${SCTP_LIBRARIES})
+endif ()
+
 if (OPENSSL_HAS_DTLS_SCTP)
 	target_compile_definitions(ocudu_gateway PRIVATE OCUDU_HAVE_OPENSSL_DTLS=1)
 	target_link_libraries(ocudu_gateway ocudu_support ocudulog OpenSSL::SSL OpenSSL::Crypto ${SCTP_LIBRARIES})
-- 
