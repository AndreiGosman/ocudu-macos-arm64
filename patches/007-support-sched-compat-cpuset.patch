index 165cef4..5007824 100644
--- a/include/ocudu/support/cpu_architecture_info.h
+++ b/include/ocudu/support/cpu_architecture_info.h
@@ -5,6 +5,7 @@
 
 #include "ocudu/adt/bounded_bitset.h"
