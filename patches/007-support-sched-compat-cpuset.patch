diff --git a/include/ocudu/support/os/sched_compat.h b/include/ocudu/support/os/sched_compat.h
new file mode 100644
index 0000000..367ceb7
--- /dev/null
+++ b/include/ocudu/support/os/sched_compat.h
@@ -0,0 +1,90 @@
+// SPDX-FileCopyrightText: Copyright (C) 2021-2026 Software Radio Systems Limited
+// SPDX-License-Identifier: BSD-3-Clause-Open-MPI
+
+#pragma once
+
+/// \file
+/// \brief Scheduler primitives that are Linux extensions, provided on Darwin.
+///
+/// cpu_set_t with the CPU_* helpers, sched_getcpu() and sched_getaffinity() are glibc extensions. Darwin has none of
+/// them: there is no CPU affinity mask API at all, and the running CPU is exposed through pthread_cpu_number_np()
+/// instead. This header is a drop-in for <sched.h>: on Linux it only includes <sched.h>; on Darwin it adds the missing
+/// pieces so the callers compile unchanged.
+
+#include <sched.h>
+
+#ifdef __APPLE__
+
+#include <cstdint>
+#include <cstring>
+#include <pthread.h>
+#include <sys/sysctl.h>
+#include <sys/types.h>
+
+/// Size of the emulated CPU set, matching glibc.
+#define CPU_SETSIZE 1024
+
+/// CPU set with the same capacity as the glibc one.
+struct cpu_set_t {
+  uint64_t bits[CPU_SETSIZE / 64];
+};
+
+inline void CPU_ZERO(cpu_set_t* set)
+{
+  std::memset(set, 0, sizeof(*set));
+}
+
+inline void CPU_SET(unsigned cpu, cpu_set_t* set)
+{
+  if (cpu < CPU_SETSIZE) {
+    set->bits[cpu / 64] |= (uint64_t{1} << (cpu % 64));
+  }
+}
+
+inline void CPU_CLR(unsigned cpu, cpu_set_t* set)
+{
+  if (cpu < CPU_SETSIZE) {
+    set->bits[cpu / 64] &= ~(uint64_t{1} << (cpu % 64));
+  }
+}
+
+inline int CPU_ISSET(unsigned cpu, const cpu_set_t* set)
+{
+  return cpu < CPU_SETSIZE and ((set->bits[cpu / 64] >> (cpu % 64)) & 1U) != 0;
+}
+
+inline int CPU_COUNT(const cpu_set_t* set)
+{
+  int count = 0;
+  for (uint64_t word : set->bits) {
+    count += __builtin_popcountll(word);
+  }
+  return count;
+}
+
+/// Returns the CPU the calling thread is running on, or -1 if the OS does not say.
+inline int sched_getcpu()
+{
+  size_t cpu = 0;
+  return ::pthread_cpu_number_np(&cpu) == 0 ? static_cast<int>(cpu) : -1;
+}
+
+/// \brief Fills \c set with every logical CPU of the host.
+///
+/// Darwin has no per-thread affinity mask, so every CPU is always allowed. The pid and size arguments are accepted
+/// for signature compatibility and ignored.
+inline int sched_getaffinity(pid_t /* pid */, size_t /* cpusetsize */, cpu_set_t* set)
+{
+  int    nof_cpus = 0;
+  size_t len      = sizeof(nof_cpus);
+  if (::sysctlbyname("hw.logicalcpu", &nof_cpus, &len, nullptr, 0) != 0 or nof_cpus <= 0) {
+    nof_cpus = 1;
+  }
+  CPU_ZERO(set);
+  for (int i = 0; i < nof_cpus and i < CPU_SETSIZE; ++i) {
+    CPU_SET(static_cast<unsigned>(i), set);
+  }
+  return 0;
+}
+
+#endif // __APPLE__
