 #include <mutex>
 #include <pthread.h>
 #include <sys/types.h>
@@ -258,13 +262,64 @@ os_sched_affinity_bitmask::subtract(const os_sched_affinity_bitmask& rhs) const
 
 ///////////////////////////////////////
 
-std::thread unique_thread::make_thread(const std::string&               name,
-                                       unique_function<void()>          callable,
-                                       os_thread_realtime_priority      prio,
-                                       const os_sched_affinity_bitmask& cpu_mask)
+#ifdef __APPLE__
+
+namespace {
+
+/// What the new thread needs from its creator: the task, and a way to report its std::thread::id.
+struct os_thread_start {
+  unique_function<void()>       callable;
+  std::promise<std::thread::id> id;
+};
+
+void* os_thread_trampoline(void* arg)
+{
+  std::unique_ptr<os_thread_start> start(static_cast<os_thread_start*>(arg));
+  start->id.set_value(std::this_thread::get_id());
+  unique_function<void()> callable = std::move(start->callable);
+  start.reset();
+  callable();
+  return nullptr;
+}
+
+} // namespace
+
+detail::os_thread::os_thread(unique_function<void()> callable)
+{
+  auto start      = std::make_unique<os_thread_start>();
+  start->callable = std::move(callable);
+  std::future<std::thread::id> id_future = start->id.get_future();
+
+  ::pthread_attr_t attr;
+  ::pthread_attr_init(&attr);
+  ::pthread_attr_setstacksize(&attr, stack_size);
+  int ret = ::pthread_create(&handle, &attr, os_thread_trampoline, start.get());
+  ::pthread_attr_destroy(&attr);
+  if (ret != 0) {
+    report_fatal_error("Failed to create thread with a {} byte stack: {}", stack_size, ::strerror(ret));
+  }
+  start.release();
+  active = true;
+  id     = id_future.get();
+}
+
+void detail::os_thread::join()
+{
+  if (active) {
+    ::pthread_join(handle, nullptr);
+    active = false;
+  }
+}
+
+#endif // __APPLE__
+
+detail::os_thread unique_thread::make_thread(const std::string&               name,
+                                             unique_function<void()>          callable,
+                                             os_thread_realtime_priority      prio,
+                                             const os_sched_affinity_bitmask& cpu_mask)
 {
   // Launch thread.
-  return std::thread([name, prio, cpu_mask, callable = std::move(callable)]() {
+  return detail::os_thread([name, prio, cpu_mask, callable = std::move(callable)]() {
     std::string fixed_name = name;
 
