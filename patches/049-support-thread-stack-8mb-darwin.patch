+namespace detail {
+
+#ifdef __APPLE__
+
+/// \brief Thread with an explicit stack size, the subset of std::thread that unique_thread uses.
+///
+/// Linux gives every thread the RLIMIT_STACK default of 8 MB. Darwin gives secondary threads 512 kB, and the FAPI
+/// messages the MAC and PHY adaptors keep on the stack (a dl_tti_request is 74 kB, an ul_tti_request 34 kB, several per
+/// slot across the call chain) overflow it: the gNB died with SIGBUS in the stack probe of send_dl_tti_request() on the
+/// first slot. Threads created here get the Linux default so the same code runs on both.
+class os_thread
+{
+public:
+  static constexpr size_t stack_size = size_t{8} << 20;
+
+  os_thread() = default;
+  explicit os_thread(unique_function<void()> callable);
+  os_thread(os_thread&& other) noexcept :
+    handle(other.handle), id(other.id), active(std::exchange(other.active, false))
+  {
+  }
+  os_thread& operator=(os_thread&& other) noexcept
+  {
+    if (joinable()) {
+      std::terminate();
+    }
+    handle = other.handle;
+    id     = other.id;
+    active = std::exchange(other.active, false);
+    return *this;
+  }
+  os_thread(const os_thread&)            = delete;
+  os_thread& operator=(const os_thread&) = delete;
+  ~os_thread()
+  {
+    if (joinable()) {
+      std::terminate();
+    }
+  }
+
+  bool            joinable() const { return active; }
+  void            join();
+  std::thread::id get_id() const { return id; }
+  ::pthread_t     native_handle() const { return handle; }
+
+private:
+  ::pthread_t     handle{};
+  std::thread::id id{};
+  bool            active = false;
+};
+
+#else
+
+using os_thread = std::thread;
+
+#endif // __APPLE__
+
+} // namespace detail
+
 /// Unique thread wrapper that ensures the thread is joined on destruction and provides an interface to set/get
 /// the thread name, priority, cpu mask.
 class unique_thread
@@ -237,15 +298,15 @@ public:
 
 private:
   /// Starts thread with provided name and attributes.
-  static std::thread make_thread(const std::string&               name,
-                                 unique_function<void()>          callable,
-                                 os_thread_realtime_priority      prio     = os_thread_realtime_priority::no_realtime(),
-                                 const os_sched_affinity_bitmask& cpu_mask = {});
+  static detail::os_thread make_thread(const std::string&               name,
+                                       unique_function<void()>          callable,
+                                       os_thread_realtime_priority      prio = os_thread_realtime_priority::no_realtime(),
+                                       const os_sched_affinity_bitmask& cpu_mask = {});
 
   /// Thread name.
   std::string name;
 
-  std::thread thread_handle;
+  detail::os_thread thread_handle;
 };
 
