diff --git a/tests/unittests/gateways/sctp_test_helpers.h b/tests/unittests/gateways/sctp_test_helpers.h
index 051f511..fd1016c 100644
--- a/tests/unittests/gateways/sctp_test_helpers.h
+++ b/tests/unittests/gateways/sctp_test_helpers.h
@@ -12,6 +12,21 @@
 #include <netdb.h>
 #include <netinet/sctp.h>
 
+/// \brief Skips a test that binds an SCTP endpoint to an lo0 alias (127.0.0.x, x > 1) or to an IPv6 address on Darwin.
+///
+/// On macOS the SCTP stack behind the socket API is usrsctp over UDP encapsulation (libsctp-compat). With an endpoint
+/// bound to an lo0 alias the INIT handshake completes but no later packet is delivered, and IPv6 endpoints are not
+/// exercised by this port at all. Both are properties of that stack, not of the code under test, so the tests that need
+/// them are skipped there and keep running on Linux.
+#ifdef __APPLE__
+#define OCUDU_SKIP_IF_NO_LO0_ALIAS_OR_IPV6_SCTP()                                                                      \
+  GTEST_SKIP() << "SCTP on lo0 aliases or IPv6 is not available with usrsctp on Darwin"
+#else
+#define OCUDU_SKIP_IF_NO_LO0_ALIAS_OR_IPV6_SCTP()                                                                      \
+  do {                                                                                                                 \
+  } while (0)
+#endif
+
 namespace ocudu {
 
 /// Dummy IO broker where the registered callbacks have to be called manually.
