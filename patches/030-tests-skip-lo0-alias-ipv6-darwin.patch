 .../gateways/sctp_network_server_peer_test.cpp    |  6 ++++++
 .../gateways/sctp_network_server_test.cpp         |  1 +
 tests/unittests/gateways/sctp_socket_test.cpp     |  6 ++++++
 tests/unittests/gateways/sctp_test_helpers.h      | 15 +++++++++++++++
 5 files changed, 33 insertions(+)

