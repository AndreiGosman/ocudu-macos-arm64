From a7848d18b1786699cedfcae49e0bf5a40f13dd9d Mon Sep 17 00:00:00 2001
From: Andrei Gosman <andrei.gosman@gmail.com>
Date: Thu, 1 Oct 2026 09:27:52 +0300
Subject: [PATCH] build: patch DartConfiguration.tcl with CMake file commands,
 not sed -i

The top-level CMakeLists.txt extended the valgrind options in the
DartConfiguration.tcl generated by include(CTest) with
"sed -i \"s|...|\" DartConfiguration.tcl" through execute_process. That
form is GNU sed only: BSD sed, the /usr/bin/sed on macOS, reads the
argument after -i as a backup suffix and then treats the file name as the
script, which fails with "unterminated substitute pattern". execute_process
did not check the result, so the failure was silent and the options were
never applied.

Do the substitution with file(READ), string(REPLACE) and file(WRITE),
which behave the same on every platform, guarded so that a reconfigure
does not insert the options twice.
---
 CMakeLists.txt | 18 ++++++++++++++++--
 1 file changed, 16 insertions(+), 2 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index d36772e..5ad4e0a 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -711,8 +711,22 @@ if (CCACHE_EXECUTABLE)
 endif ()
 
 include(CTest)
-execute_process(COMMAND sed -i "s|MemoryCheckCommandOptions: |MemoryCheckCommandOptions: --verbose --trace-children=yes --time-stamp=yes --leak-check=full --show-leak-kinds=all --show-reachable=yes --exit-on-first-error=yes --error-exitcode=22 --suppressions=${CMAKE_SOURCE_DIR}/.memcheck-suppressions|" DartConfiguration.tcl
-        WORKING_DIRECTORY ${CMAKE_BINARY_DIR})
+# Extend the valgrind options in the DartConfiguration.tcl that include(CTest)
+# generated. This used to be a "sed -i" call through execute_process, which
+# relies on GNU sed: BSD sed reads the argument after -i as a backup suffix,
+# so on macOS the command failed and execute_process discarded the error.
+set(_dart_config "${CMAKE_BINARY_DIR}/DartConfiguration.tcl")
+if (EXISTS "${_dart_config}")
+    file(READ "${_dart_config}" _dart_contents)
+    if (NOT _dart_contents MATCHES "--suppressions=")
+        string(REPLACE "MemoryCheckCommandOptions: "
+               "MemoryCheckCommandOptions: --verbose --trace-children=yes --time-stamp=yes --leak-check=full --show-leak-kinds=all --show-reachable=yes --exit-on-first-error=yes --error-exitcode=22 --suppressions=${CMAKE_SOURCE_DIR}/.memcheck-suppressions"
+               _dart_contents "${_dart_contents}")
+        file(WRITE "${_dart_config}" "${_dart_contents}")
+    endif ()
+endif ()
+unset(_dart_config)
+unset(_dart_contents)
 
 include_directories(include)
 include_directories(external/fmt/include)
-- 
2.55.0

