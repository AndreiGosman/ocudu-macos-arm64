From ac56908d019c6dddb61072db70f75fcc4ffe111a Mon Sep 17 00:00:00 2001
From: Andrei Gosman <andrei.gosman@gmail.com>
Date: Thu, 1 Oct 2026 12:21:40 +0300
Subject: [PATCH] gateways: propagate the SCTP include directory to
 ocudu_gateway and its users

FindSCTP.cmake reports SCTP_INCLUDE_DIRS, but lib/gateways only linked
${SCTP_LIBRARIES} and never added the include directory. On Linux this
goes unnoticed because the header lives in /usr/include. With libsctp
installed under another prefix, the libsctp-compat shim in a user prefix
on macOS, every translation unit that includes
<netinet/sctp.h> fails with "file not found".

Add the directory as a SYSTEM PUBLIC include of ocudu_gateway. PUBLIC
because include/ocudu/gateways/sctp_socket.h includes the header itself,
so tests and applications that use the gateway need it too. CMake drops
the entry when it is an implicit compiler directory, so Linux builds are
unchanged.
---
 lib/gateways/CMakeLists.txt | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/lib/gateways/CMakeLists.txt b/lib/gateways/CMakeLists.txt
index a0d9853..98ec6f3 100644
--- a/lib/gateways/CMakeLists.txt
+++ b/lib/gateways/CMakeLists.txt
@@ -27,6 +27,11 @@ add_library(ocudu_gateway
         udp_network_gateway_factory.cpp
 )
 
+# The SCTP header is part of the public gateway interface (sctp_socket.h includes <netinet/sctp.h>), so every
+# consumer needs the directory FindSCTP found. On Linux that is /usr/include and CMake drops it as implicit; with a
+# libsctp installed under another prefix, as on macOS, this is what makes the header reachable.
+target_include_directories(ocudu_gateway SYSTEM PUBLIC ${SCTP_INCLUDE_DIRS})
+
 if (OPENSSL_HAS_DTLS_SCTP)
 	target_compile_definitions(ocudu_gateway PRIVATE OCUDU_HAVE_OPENSSL_DTLS=1)
 	target_link_libraries(ocudu_gateway ocudu_support ocudulog OpenSSL::SSL OpenSSL::Crypto ${SCTP_LIBRARIES})
-- 
