From 2726a4ea64334912b02932f730fc4af87a6f758e Mon Sep 17 00:00:00 2001
From: Andrei Gosman <andrei.gosman@gmail.com>
Date: Thu, 1 Oct 2026 11:35:53 +0300
Subject: [PATCH] support: map the pool memory region without MAP_HUGETLB on
 Darwin

pool_memory_region.cpp asks mmap for MAP_HUGETLB | MAP_POPULATE when the
caller requests huge pages. Both flags are Linux-only; Darwin's mman.h
has neither, and its superpage support (VM_FLAGS_SUPERPAGE_SIZE_2MB) is
x86-only and not reachable through these flags.

Where MAP_HUGETLB is not defined, map a plain anonymous region and
mlock() it best effort: the lock faults the pages in and keeps them
resident, which is what the caller wants from the huge page mapping. The
log line says what was mapped instead of claiming huge pages. The
/proc/meminfo huge page size probe already falls back to 2 MB when the
file is absent, so the alignment logic is unchanged.
---
 lib/support/pool_memory_region.cpp | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/lib/support/pool_memory_region.cpp b/lib/support/pool_memory_region.cpp
index 59c1f1f..0716f91 100644
--- a/lib/support/pool_memory_region.cpp
+++ b/lib/support/pool_memory_region.cpp
@@ -53,6 +53,7 @@ static std::size_t system_hugepage_size()
 /// Maps the requested size in bytes to the reserved huge page region.
 static uint8_t* map_to_hugepage_region(std::size_t aligned_size)
 {
+#ifdef MAP_HUGETLB
   // Note: MAP_POPULATE prefaults the mapped pages.
   uint8_t* ptr = static_cast<uint8_t*>(::mmap(
       nullptr, aligned_size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_HUGETLB | MAP_POPULATE, -1, 0));
@@ -62,6 +63,17 @@ static uint8_t* map_to_hugepage_region(std::size_t aligned_size)
   }
 
   return nullptr;
+#else
+  // No huge page or prefault flags on this OS (Darwin). Map a plain anonymous region and lock it, which faults the
+  // pages in and keeps them resident, the two effects the caller wants from huge pages. Locking is best effort: it
+  // fails without raised limits and the mapping is still usable.
+  uint8_t* ptr = static_cast<uint8_t*>(::mmap(nullptr, aligned_size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0));
+  if (ptr == MAP_FAILED) {
+    return nullptr;
+  }
+  (void)::mlock(ptr, aligned_size);
+  return ptr;
+#endif
 }
 
 /// Allocates the memory of the requested size either on heap or by mapping huge pages.
@@ -88,7 +100,11 @@ static std::variant<heap_memory_resource, hugepage_memory_resource> make_storage
 
     // Successfully mapped to huge pages.
     if (ptr != nullptr) {
+#ifdef MAP_HUGETLB
       memory_region_logger.info("Memory region successfully mapped to huge page(s).");
+#else
+      memory_region_logger.info("Memory region mapped as a locked anonymous region (no huge pages on this OS).");
+#endif
       return hugepage_memory_resource{ptr, size_bytes, aligned_size};
     }
     memory_region_logger.warning("Failed to map memory region to huge page(s), fallback to malloc() style.");
-- 
